{
  "compilerOptions": {
    "module": "es2022",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "moduleResolution": "node"
  },
  "include": ["src/ui/webview/main.ts", "src/ui/webview/globals.d.ts"],
  "exclude": ["node_modules", "dist"]
}
